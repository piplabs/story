# ============================================================================
# DKG Integration Test — Unified Configuration
# ============================================================================
# Copy this file to config.env and fill in the values for your environment.
# Then source it before running tests:
#   source tests/integration/dkg/config.env
#   go test -tags=integration -v ./tests/integration/dkg/...
# ============================================================================

# ---------------------------------------------------------------------------
# 1. RPC Connections (REQUIRED)
# ---------------------------------------------------------------------------
# Point to any validator's CometBFT RPC and EL JSON-RPC endpoints.
# Using SSH tunnel: ssh -L 26657:localhost:26657 -L 8545:localhost:8545 ...

# Story consensus CometBFT RPC endpoint (used for ABCI queries)
export STORY_RPC_URL="http://localhost:26657"

# Story execution layer JSON-RPC endpoint (required for CDR / upgrade tests)
export STORY_ETH_RPC_URL="http://localhost:8545"

# ---------------------------------------------------------------------------
# 2. Chain Interaction Keys (REQUIRED for CDR / upgrade scenarios)
# ---------------------------------------------------------------------------

# Private key (hex, with or without 0x prefix) for DKG contract calls.
# Must be the contract owner. Default devnet owner key:
export DKG_SIGNER_PRIVATE_KEY="ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# ---------------------------------------------------------------------------
# 3. Contract Addresses (optional — defaults to predeploys)
# ---------------------------------------------------------------------------

# DKG precompile address (default: 0xCcCcCC0000000000000000000000000000000004)
export DKG_CONTRACT_ADDRESS=""

# CDR precompile address (default: 0xCcCcCC0000000000000000000000000000000005)
export CDR_CONTRACT_ADDRESS=""

# ---------------------------------------------------------------------------
# 4. Scenario Driver (REQUIRED for fault-injection / scenario tests)
# ---------------------------------------------------------------------------

# Set to "script" to enable ScriptDriver (pre.sh / post.sh execution)
export DKG_DRIVER="script"

# Path to scenario scripts directory (relative to the story repo root)
export DKG_SCENARIO_SCRIPTS_DIR="scripts/dkg_e2e/scenarios"

# ---------------------------------------------------------------------------
# 5. Polling / Timeout
# ---------------------------------------------------------------------------

# How often to poll for stage transitions (default: 10s)
export DKG_POLL_INTERVAL="5s"

# Maximum wait time for any stage transition (default: 600s)
# A full DKG round is ~860 blocks (~29 min at 2s/block). Set to 2000s for safety.
export DKG_MAX_WAIT="2000s"

# ---------------------------------------------------------------------------
# 6. Validator Node Access (used by scenario scripts)
# ---------------------------------------------------------------------------
# The devnet has 3 validators with SGX + 1 bootnode (no kernel).
# Scenario scripts SSH into validators to stop/start services.

# Deployment mode: "ssh" for the SGX devnet
export DKG_DEPLOY_MODE="ssh"

# Number of validators (3 for the current devnet; bootnode is not counted)
export DKG_VALIDATOR_COUNT="3"

# Comma-separated SSH targets (user@host) for validators 1..N
# Maps to: val1=20.46.165.193, val2=20.48.25.208, val3=40.115.139.113
export DKG_SSH_TARGETS="ubuntu@20.46.165.193,ubuntu@20.48.25.208,ubuntu@40.115.139.113"

# Bootnode IP (no kernel, used for peer discovery)
export DKG_BOOTNODE_IP="23.102.71.16"
export DKG_BOOTNODE_USER="ubuntu"

# SSH private key path
export DKG_SSH_KEY="$HOME/.ssh/dkg.pem"

# SSH options (disable host key checking for devnet)
export DKG_SSH_OPTS="-o StrictHostKeyChecking=no"

# ---------------------------------------------------------------------------
# 7. Service Names (systemd on remote validators)
# ---------------------------------------------------------------------------
# On the devnet, services are plain names (not templated).

# story consensus service name
export DKG_SYSTEMD_STORY_SERVICE="story"

# story-kernel (TEE) service name
export DKG_SYSTEMD_KERNEL_SERVICE="story-kernel"

# ---------------------------------------------------------------------------
# 8. Validator Config Paths (on remote machines)
# ---------------------------------------------------------------------------

# Path to story.toml containing [dkg] section (on each validator)
export DKG_STORY_TOML_PATH="/home/ubuntu/.story/story/config/story.toml"

# story-kernel home directory (on each validator)
export DKG_KERNEL_HOME="/home/ubuntu/.story-kernel"

# ---------------------------------------------------------------------------
# 9. Upgrade Scenario Parameters
# ---------------------------------------------------------------------------

# Upgrade version string used by ScheduleUpgrade
export DKG_UPGRADE_VERSION="v2.0.0-test"

# How many blocks ahead of current height to set activationHeight
# DKG round is ~860 blocks; set offset large enough to pass through a full round.
export DKG_UPGRADE_ACTIVATION_OFFSET="100"

# ---------------------------------------------------------------------------
# 10. Gas Settings (EL transactions)
# ---------------------------------------------------------------------------
# The devnet geth miner minimum is 16 gwei. We use 17 gwei for safety.
export DKG_GAS_PRICE="17000000000"

# ---------------------------------------------------------------------------
# 11. Chain-specific Overrides
# ---------------------------------------------------------------------------

# V200 upgrade height for LocalChainID (story-1001511).
# The devnet genesis uses LocalChainID which has Horace=100, V200=2000 by default.
# We override V200 to 100 so DKG activates quickly after chain reset.
export DKG_V200_HEIGHT="105"

# MockValidationHook address deployed via GenerateAlloc.s.sol.
# Used as fallback when whitelisting enclave types.
export DKG_MOCK_VALIDATION_HOOK="0x858F0B7C7c9f440F1bbA90a48Ab4A941C4E44E58"

# EL (geth) chain ID. Must match genesis-geth.json chainId.
# reset_devnet.sh auto-detects and fixes engine-chain-id in story.toml.
export DKG_EL_CHAIN_ID="1511"

# ---------------------------------------------------------------------------
# 12. DCAP Attestation (Real Automata on-chain SGX quote verification)
# ---------------------------------------------------------------------------
# When enabled, deploy_dcap.sh deploys Automata DCAP contracts and uploads
# Intel collateral. DKG registration uses real SGX quote verification (~7.7M gas).
# When disabled (default), MockValidationHook is used (always passes).

# Enable real DCAP attestation (default: false = MockValidationHook)
export DKG_DCAP_ENABLED="true"

# Automata DCAP repo path on val1 (auto-cloned if missing)
export DKG_DCAP_REPO_PATH="/home/ubuntu/automata-dcap-attestation"

# Automata DCAP repo branch/tag
export DKG_DCAP_REPO_BRANCH="main"

# TCB Evaluation Data Number (Intel's current value; check via:
#   curl -s https://api.trustedservices.intel.com/sgx/certification/v4/qe/identity | jq '.enclaveIdentity.tcbEvaluationDataNumber')
export DKG_TCB_EVAL_NUMBER="18"

# FMSPC for Azure DCsv3 (Intel Xeon Platinum 8370C / Ice Lake-SP)
export DKG_FMSPC="00606A000000"

# DKG owner key for DCAP contract ownership (defaults to DKG_SIGNER_PRIVATE_KEY)
export DKG_OWNER_KEY="${DKG_SIGNER_PRIVATE_KEY}"

# Local collateral bundle directory (fallback when Intel PCS API is unreachable).
# Expected files: root_ca.der, platform_ca.der, signing_ca.der, root_crl.der, pck_crl.der,
#                 qe_identity.json, tcb_info.json
# If empty, only live fetch from Intel PCS API is attempted.
export DKG_DCAP_COLLATERAL_DIR=""

# SGXValidationHook proxy address (auto-detected from on-chain DKG.enclaveTypeData).
# Override only if the default detection fails.
export DKG_SGX_HOOK_PROXY=""
export DKG_UPGRADE_ACTIVATION_OFFSET="20"

# Git branches for code updates during configure_periods
export DKG_STORY_BRANCH="dkg/dev"
export DKG_KERNEL_BRANCH="main"
# Pin story to a specific commit (set empty to use latest dkg/dev).
# Leave empty to use latest.
export DKG_STORY_PIN_COMMIT=""
